{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "UV_CACHE_DIR": ".cache/uv"
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.envrc)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/claude-harness/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.netrc)",
      "Read(~/.pypirc)",
      "Read(~/.git-credentials)",
      "Read(~/.claude/.credentials.json)",
      "Edit(/.claude/**)",
      "Edit(/.github/workflows/**)",
      "Edit(/.github/harness/**)",
      "Edit(/.github/CODEOWNERS)",
      "Edit(/.pre-commit-config.yaml)",
      "Edit(/.security/**)",
      "Edit(/quality-gates.toml)",
      "Bash(sudo *)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push * --force)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git commit * --no-verify)",
      "Bash(git commit --no-verify *)",
      "Bash(gh secret *)",
      "Bash(gh auth token)",
      "Bash(gh pr review * --approve)",
      "Bash(gh pr merge)",
      "Bash(gh pr merge *)"
    ],
    "ask": [
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(pip install *)",
      "Bash(uv pip install *)",
      "WebFetch"
    ],
    "allow": [
      "Bash(make help)",
      "Bash(make setup)",
      "Bash(make lint)",
      "Bash(make format)",
      "Bash(make test)",
      "Bash(make scan)",
      "Bash(make build)",
      "Bash(make doctor)",
      "Bash(uv run pytest *)",
      "Bash(uv sync)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(python3 .claude/tools/watch_pr.py *)",
      "Bash(python3 .claude/tools/next_issue.py)",
      "Bash(gh pr list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.kube",
        "~/.config/gh",
        "~/.config/claude-harness",
        "~/.docker/config.json",
        "~/.netrc",
        "~/.pypirc",
        "~/.git-credentials",
        "~/.claude/.credentials.json",
        "~/**/.env",
        "~/**/.env.*"
      ],
      "allowRead": [
        "**/certifi/cacert.pem"
      ],
      "denyWrite": [
        ".claude",
        ".github/workflows",
        ".github/harness",
        ".github/CODEOWNERS",
        ".pre-commit-config.yaml",
        ".security",
        "quality-gates.toml"
      ]
    },
    "network": {
      "allowedDomains": [
        "pypi.org",
        "files.pythonhosted.org",
        "github.com",
        "api.github.com",
        "*.githubusercontent.com"
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session_start.py",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_bash.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect_files.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/require_ask_tool.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
